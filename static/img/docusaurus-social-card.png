<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <!-- Background -->
  <rect width="1200" height="630" fill="#1a2a6c"/>

  <!-- Gradient overlay -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a2a6c"/>
      <stop offset="100%" stop-color="#b21f1f"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bgGradient)"/>

  <!-- Robot/Logo elements -->
  <g transform="translate(500, 200)">
    <!-- Robot head -->
    <rect x="-50" y="-40" width="100" height="80" rx="10" fill="white" opacity="0.1"/>

    <!-- Circuit patterns -->
    <g stroke="white" stroke-width="2" opacity="0.3">
      <circle cx="-20" cy="-10" r="15"/>
      <circle cx="20" cy="-10" r="15"/>
      <circle cx="0" cy="20" r="15"/>

      <path d="M -30 -30 L 30 30 M -30 30 L 30 -30 M -40 0 L 40 0 M 0 -40 L 0 40"/>
    </g>

    <!-- Main icon -->
    <g transform="scale(2)">
      <rect x="-15" y="-15" width="30" height="30" rx="5" fill="white" opacity="0.2"/>
      <circle cx="-7" cy="-7" r="3" fill="white"/>
      <circle cx="7" cy="-7" r="3" fill="white"/>
      <rect x="-5" y="3" width="10" height="2" fill="white"/>
    </g>
  </g>

  <!-- Title text -->
  <text x="600" y="400" font-family="Arial, sans-serif" font-size="48" fill="white" text-anchor="middle" font-weight="bold">
    Physical AI &amp; Humanoid Robotics
  </text>

  <!-- Subtitle -->
  <text x="600" y="460" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">
    Bridging Digital AI and Embodied Intelligence
  </text>

  <!-- Tagline -->
  <text x="600" y="500" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle" opacity="0.8">
    Learn to build intelligent robotic systems that perceive, think, and act
  </text>

  <!-- Website info -->
  <text x="600" y="580" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle" opacity="0.6">
    ayesha788.github.io/new_book
  </text>
</svg>